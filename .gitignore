# Build subdirectories.
/*build*
!/build-aux
!/build_msvc
!/build_release.ps1
!/build_release.sh

*.pyc

# Only ignore unexpected patches
*.patch
!contrib/guix/patches/*.patch
!depends/patches/**/*.patch

/CMakeUserPresets.json

# Previous releases
/releases

#build tests
test/lint/test_runner/target/

/guix-build-*

/ci/scratch/
*.tar.gz
*.zip

# Pool artifacts
pool_ui/*.db
*.log
__pycache__/
*.pyc

# Credentials (should never be committed)
**/credentials
*.env

# Generated release directories
Retardio-v*/

# Claude Code local settings (contains command history)
.claude/
